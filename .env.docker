# .env.docker — Environment variables for the Docker build
#
# This file is read by Docker Compose and passed as build arguments (ARGs)
# to the Dockerfile. Because Vite bakes VITE_* variables at build time, these
# values must be set BEFORE `npm run build` runs inside the container.
#
# ⚠️  Add this file to .gitignore if it ever contains secrets.
#     For now it only holds non-sensitive config, so it is safe to commit.
#
# Usage:
#   docker compose --env-file .env.docker up --build
#   (Docker Compose also auto-loads a file named exactly ".env" in the project root)

# ─── Application ──────────────────────────────────────────────────────────────
VITE_APP_NAME=Leave Management System
VITE_APP_VERSION=1.0.0

# ─── API ──────────────────────────────────────────────────────────────────────
# For the Docker build, the mock API is enabled so no real backend is needed.
# When you wire up a real backend service in Compose, change this to:
#   VITE_API_BASE_URL=http://backend:3000/api
#   VITE_ENABLE_MOCK_API=false
VITE_API_BASE_URL=http://localhost:3000/api
VITE_REQUEST_TIMEOUT=8000

# ─── Feature Flags ────────────────────────────────────────────────────────────
# true  = axios-mock-adapter intercepts all requests (standalone mode)
# false = requests go to VITE_API_BASE_URL (requires a running backend)
VITE_ENABLE_MOCK_API=true
