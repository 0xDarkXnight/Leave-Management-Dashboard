# ─── Application ──────────────────────────────────────────────────────────────
VITE_APP_NAME=Leave Management System
VITE_APP_VERSION=1.0.0

# ─── API ──────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api
VITE_REQUEST_TIMEOUT=8000

# ─── Feature Flags ────────────────────────────────────────────────────────────
# true  = requests are intercepted by axios-mock-adapter (no real server needed)
# false = requests go to VITE_API_BASE_URL (requires a running backend)
VITE_ENABLE_MOCK_API=true